{
  "name": "ledmap",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "testar": "node testes/cabeamento.mjs && node testes/espaco.mjs",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "26.16.1",
    "vite": "^5.4.0",
    "three": "0.185.1"
  },
  "description": "Mapa de painéis LED: rig, canvas, cabeamento, composição e elétrica",
  "author": "Zuperney",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.zuperney.ledmap",
    "productName": "Led Map",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Led Map",
      "artifactName": "Led-Map-Setup-${version}.${ext}"
    }
  }
}
